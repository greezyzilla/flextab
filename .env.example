# Copy to .env.development (local) and .env.production (Web Store build).
# All PLASMO_PUBLIC_* vars are inlined into the bundle at build time — never put
# secrets here (OAuth client secret etc. stays on the backend only).

# Backend base URL the API client fetches from.
PLASMO_PUBLIC_API_URL=http://localhost:3000

# Host match pattern injected into manifest `host_permissions`.
# Scope to the API host only; must end with /*. Ports are ignored by Chrome.
PLASMO_PUBLIC_API_HOST=http://localhost/*
