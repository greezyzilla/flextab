{
  "name": "flextab",
  "displayName": "Flextab",
  "version": "0.0.1",
  "description": "A flexible tab manager",
  "author": "GreezyZilla",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.13.18",
    "plasmo": "^0.90.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "uuid": "^11.1.0",
    "yjs": "^13.6.31",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@expo/spawn-async": "^1.7.2",
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "0.0.258",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.24",
    "change-case": "^4.1.2",
    "eslint": "^9.30.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.2.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "prettier": "3.2.4",
    "sharp": "^0.34.5",
    "string-width": "^8.1.1",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "manifest": {
    "permissions": [
      "tabs",
      "storage",
      "unlimitedStorage"
    ],
    "host_permissions": [
      "https://*/*",
      "http://localhost/*"
    ]
  },
  "overrides": {
    "jiti": "^1.21.7"
  }
}
