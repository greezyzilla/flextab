{
  "name": "flextab",
  "displayName": "Flextab",
  "version": "0.1.0",
  "description": "Organize your tabs into spaces, projects, and groups. A beautiful new tab page that keeps your browsing life in order.",
  "author": "GreezyZilla",
  "scripts": {
    "dev": "plasmo dev",
    "check-env": "node scripts/check-env.mjs",
    "build": "npm run check-env && plasmo build",
    "build:zip": "npm run check-env && plasmo build --zip",
    "release:patch": "npm version patch -m \"release: v%s\" && npm run build:zip",
    "release:minor": "npm version minor -m \"release: v%s\" && npm run build:zip",
    "package": "plasmo package",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-virtual": "^3.13.18",
    "plasmo": "^0.90.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^3.4.19",
    "uuid": "^11.1.0",
    "yjs": "^13.6.31",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@expo/spawn-async": "^1.7.2",
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "0.0.258",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.24",
    "change-case": "^4.1.2",
    "eslint": "^9.30.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.2.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "prettier": "3.2.4",
    "sharp": "^0.34.5",
    "string-width": "^8.1.1",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "manifest": {
    "permissions": [
      "tabs",
      "storage",
      "unlimitedStorage"
    ],
    "host_permissions": [
      "$PLASMO_PUBLIC_API_HOST"
    ]
  },
  "overrides": {
    "jiti": "^1.21.7"
  }
}
